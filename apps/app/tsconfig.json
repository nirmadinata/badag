{
    "compilerOptions": {
        "target": "es2024",
        "lib": ["es2024"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "types": ["vite/client"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "cloudflare.config.ts", ".cloudflare/types"]
}
