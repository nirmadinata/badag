{
    "name": "@badag/dashboard",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "cf dev",
        "generate-routes": "tsr generate",
        "build": "cf build",
        "preview": "vite preview",
        "deploy": "cf deploy",
        "typecheck": "cf workers types && tsc",
        "db:generate:main": "drizzle-kit generate --dialect sqlite --driver durable-sqlite --schema node_modules/@badag/db-schema/src/main-db/schema.ts --out migrations/main-db",
        "db:generate:do": "drizzle-kit generate --dialect sqlite --driver durable-sqlite --schema node_modules/@badag/db-schema/src/orchestrator-db/schema.ts --out migrations/orchestrator-db",
        "db:generate": "bun db:generate:main && bun db:generate:do",
        "db:clean-generate": "rm -rf migrations && bun db:generate:main && bun db:generate:do",
        "db:migrate": "cf d1 migrations apply 00000000000000000000000000000000 --local --persist-to .cloudflare/state --dir migrations/main-db",
        "test:e2e": "vitest run --config vitest.e2e.config.ts"
    },
    "dependencies": {
        "@badag/db-schema": "workspace:*",
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@hono/zod-openapi": "^1.6.3",
        "@scalar/hono-api-reference": "^0.12.17",
        "@t3-oss/env-core": "^0.13.11",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-devtools": "0.10.14",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "5.105.0",
        "@tanstack/react-query-devtools": "5.105.0",
        "@tanstack/react-router": "1.170.46",
        "@tanstack/react-router-devtools": "1.167.2",
        "@tanstack/react-router-ssr-query": "1.167.3",
        "@tanstack/react-start": "1.169.4",
        "better-auth": "^1.7.15",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.5.1",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.16",
        "lucide-react": "^1.66.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0",
        "valibot": "^1.5.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^2.0.0-beta.v.8",
        "@tanstack/devtools-vite": "0.8.6",
        "@tanstack/router-cli": "^1.132.0",
        "@types/node": "latest",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "cf": "^1.0.0-beta.28",
        "drizzle-kit": "^0.31.11",
        "playwright": "^1.64.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.0",
        "vitest": "^5.0.5"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "lightningcss",
            "sharp",
            "workerd"
        ]
    }
}
