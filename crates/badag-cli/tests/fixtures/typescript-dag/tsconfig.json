{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["es2023"],
        "moduleDetection": "force",
        "module": "preserve",
        "moduleResolution": "bundler",
        "types": [],
        "strict": true,
        "noUnusedLocals": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["dags"]
}
