{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["es2023", "dom"],
        "moduleDetection": "force",
        "module": "preserve",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "types": [],
        "strict": true,
        "noUnusedLocals": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        // Core is imported from source, so both trees share one program.
        "rootDir": ".."
    },
    "include": ["src", "../core/src"],
    "exclude": ["../core/src/**/*.test.ts"]
}
