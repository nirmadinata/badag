{
    "$schema": "node_modules/turbo/schema.json",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": [".cloudflare/output/**", "dist", ".crust"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["reports/**"]
        },
        "test:e2e": {
            "dependsOn": ["^build"],
            "outputs": ["reports/**"]
        }
    }
}
